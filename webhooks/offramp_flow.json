    {
      "id": "OFFRAMP_CRYPTO_REVIEW",
      "title": "Payment Authorization",
      "data": {
        "currency": {
          "type": "string",
          "__example__": "USDC"
        },
        "network": {
          "type": "string",
          "__example__": "BASE"
        },
        "sell_amount": {
          "type": "string",
          "__example__": "5000"
        },
        "sell_amount_usd": {
          "type": "string",
          "__example__": "3.73"
        },
        "amount_to_receive": {
          "type": "string",
          "__example__": "5,000"
        },
        "total_amount_usd": {
          "type": "string",
          "__example__": "4.48"
        },
        "bank_name": {
          "type": "string",
          "__example__": "GTBank"
        },
        "bank_code": {
          "type": "string",
          "__example__": "000013"
        },
