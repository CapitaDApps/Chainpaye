{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SELECT_CURRENCY": ["OFFRAMP_DETAILS", "RWF_DETAILS", "ZAR_DETAILS", "COMING_SOON"],
    "OFFRAMP_DETAILS": ["OFFRAMP_FIAT_REVIEW"],
    "RWF_DETAILS": ["RWF_REVIEW"],
    "RWF_REVIEW": ["RWF_AUTHORIZE"],
    "RWF_AUTHORIZE": ["OFFRAMP_SUCCESS"],
    "ZAR_DETAILS": ["ZAR_REVIEW"],
    "ZAR_REVIEW": ["ZAR_AUTHORIZE"],
    "ZAR_AUTHORIZE": ["OFFRAMP_SUCCESS"],
    "OFFRAMP_FIAT_REVIEW": ["OFFRAMP_CRYPTO_REVIEW"],
    "OFFRAMP_CRYPTO_REVIEW": ["OFFRAMP_SUCCESS"],
    "OFFRAMP_SUCCESS": [],
    "COMING_SOON": []
  },
  "screens": [
    {
      "id": "SELECT_CURRENCY",
      "title": "Spend Crypto",
      "data": {
        "error_message": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Select Payout Country"
          },
          {
            "type": "TextBody",
            "text": "Choose the country you want to receive funds in."
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              {
                "type": "TextCaption",
                "text": "${data.error_message}"
              }
            ]
          },
          {
            "type": "Form",
            "name": "currency_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "payout_country",
                "label": "Payout Country",
                "required": true,
                "data-source": [
                  { "id": "NGN", "title": "🇳🇬 Nigeria (NGN)" },
                  { "id": "KES", "title": "🇰🇪 Kenya (KES)" },
                  { "id": "ZAR", "title": "🇿🇦 South Africa (ZAR)" },
                  { "id": "RWF", "title": "🇷🇼 Rwanda (RWF)" },
                  { "id": "UGX", "title": "🇺🇬 Uganda (UGX)" },
                  { "id": "MWK", "title": "🇲🇼 Malawi (MWK)" },
                  { "id": "TZS", "title": "🇹🇿 Tanzania (TZS)" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "payout_country": "${form.payout_country}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "OFFRAMP_DETAILS",
      "title": "Off-Ramp (Sell Crypto)",
      "data": {
        "banks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "000014", "title": "Access Bank" },
            { "id": "000013", "title": "GTBank" }
          ]
        },
        "prefilledAmount": {
          "type": "string",
          "__example__": ""
        },
        "prefilledBankCode": {
          "type": "string",
          "__example__": ""
        },
        "prefilledBankName": {
          "type": "string",
          "__example__": ""
        },
        "prefilledAccountNumber": {
          "type": "string",
          "__example__": ""
        },
        "hasPrefillData": {
          "type": "boolean",
          "__example__": false
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "If",
            "condition": "${data.hasPrefillData}",
            "then": [
              {
                "type": "TextHeading",
                "text": "Payment from Image 📸"
              },
              {
                "type": "TextCaption",
                "text": "Check the message above for the details to enter"
              }
            ],
            "else": [
              {
                "type": "TextHeading",
                "text": "Withdraw to Bank"
              }
            ]
          },
          {
            "type": "Form",
            "name": "offramp_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "currency",
                "label": "Asset to Sell",
                "required": true,
                "data-source": [
                  {
                    "id": "USDT",
                    "title": "Tether (USDT)"
                  },
                  {
                    "id": "USDC",
                    "title": "USD Coin (USDC)"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "network",
                "label": "Select Network",
                "required": true,
                "data-source": [
                  {
                    "id": "BEP20",
                    "title": "BNB Smart Chain (BEP20)"
                  },
                  {
                    "id": "SOL",
                    "title": "Solana (SOL)"
                  },
                  {
                    "id": "BASE",
                    "title": "Base Network"
                  },
                  {
                    "id": "ARBITRUM",
                    "title": "Arbitrum"
                  },
                  {
                    "id": "STELLAR",
                    "title": "Stellar (XLM)"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "bank_code",
                "label": "Select Bank",
                "required": true,
                "data-source": "${data.banks}"
              },
              {
                "type": "TextInput",
                "name": "account_number",
                "label": "Account Number",
                "required": true,
                "input-type": "text",
                "helper-text": "Enter 10-digit account number"
              },
              {
                "type": "TextInput",
                "name": "sell_amount",
                "label": "Amount (NGN)",
                "required": true,
                "input-type": "text",
                "helper-text": "Min: ₦5,000"
              },
              {
                "type": "Footer",
                "label": "Preview Withdrawal",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "currency": "${form.currency}",
                    "network": "${form.network}",
                    "sell_amount": "${form.sell_amount}",
                    "bank_code": "${form.bank_code}",
                    "account_number": "${form.account_number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RWF_DETAILS",
      "title": "Withdraw to Rwanda",
      "data": {
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "MTN", "title": "MTN Rwanda" },
            { "id": "Mobile Wallet", "title": "Mobile Wallet" }
          ]
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Withdraw to Rwanda 🇷🇼"
          },
          {
            "type": "TextBody",
            "text": "Enter your mobile money details to receive RWF."
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              {
                "type": "TextCaption",
                "text": "${data.error_message}"
              }
            ]
          },
          {
            "type": "Form",
            "name": "rwf_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "crypto_asset",
                "label": "Asset to Sell",
                "required": true,
                "data-source": [
                  { "id": "USDT", "title": "Tether (USDT)" },
                  { "id": "USDC", "title": "USD Coin (USDC)" }
                ]
              },
              {
                "type": "Dropdown",
                "name": "crypto_network",
                "label": "Select Network",
                "required": true,
                "data-source": [
                  { "id": "BASE", "title": "Base Network" },
                  { "id": "ERC20", "title": "Ethereum (ERC20)" },
                  { "id": "POLYGON", "title": "Polygon" },
                  { "id": "OPTIMISM", "title": "Optimism" },
                  { "id": "ARBITRUM", "title": "Arbitrum" },
                  { "id": "SOL", "title": "Solana (SOL)" },
                  { "id": "AVALANCHE", "title": "Avalanche" }
                ]
              },
              {
                "type": "Dropdown",
                "name": "network_code",
                "label": "Mobile Money Network",
                "required": true,
                "data-source": "${data.networks}"
              },
              {
                "type": "TextInput",
                "name": "phone_number",
                "label": "Mobile Money Number",
                "required": true,
                "input-type": "phone",
                "helper-text": "Enter number registered with mobile money (e.g. 07XXXXXXXX)"
              },
              {
                "type": "TextInput",
                "name": "sell_amount",
                "label": "Amount (RWF)",
                "required": true,
                "input-type": "number",
                "helper-text": "Min: RWF 5,000"
              },
              {
                "type": "Footer",
                "label": "Preview Withdrawal",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "crypto_asset": "${form.crypto_asset}",
                    "crypto_network": "${form.crypto_network}",
                    "network_code": "${form.network_code}",
                    "phone_number": "${form.phone_number}",
                    "sell_amount": "${form.sell_amount}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RWF_REVIEW",
      "title": "Review RWF Withdrawal",
      "data": {
        "crypto_asset": { "type": "string", "__example__": "USDC" },
        "crypto_network": { "type": "string", "__example__": "BASE" },
        "network_code": { "type": "string", "__example__": "MTN" },
        "network_name": { "type": "string", "__example__": "MTN Rwanda" },
        "phone_number": { "type": "string", "__example__": "0781234567" },
        "sell_amount": { "type": "string", "__example__": "13500" },
        "crypto_cost": { "type": "string", "__example__": "9.63" },
        "rate": { "type": "string", "__example__": "1,402" },
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Review Details"
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              { "type": "TextCaption", "text": "${data.error_message}" }
            ]
          },
          { "type": "TextBody", "text": "`'Network: '${data.network_name}''`" },
          { "type": "TextBody", "text": "`'Mobile Number: '${data.phone_number}''`" },
          { "type": "TextBody", "text": "`'Amount: RWF '${data.sell_amount}''`" },
          { "type": "TextBody", "text": "`'You Pay: '${data.crypto_cost}' '${data.crypto_asset}''`" },
          { "type": "TextBody", "text": "`'Rate: 1 '${data.crypto_asset}' = RWF '${data.rate}''`" },
          { "type": "TextBody", "text": "`'Network: '${data.crypto_network}''`" },
          {
            "type": "Footer",
            "label": "Proceed to Payment",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "crypto_asset": "${data.crypto_asset}",
                "crypto_network": "${data.crypto_network}",
                "network_code": "${data.network_code}",
                "network_name": "${data.network_name}",
                "phone_number": "${data.phone_number}",
                "sell_amount": "${data.sell_amount}",
                "crypto_cost": "${data.crypto_cost}",
                "rate": "${data.rate}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RWF_AUTHORIZE",
      "title": "Authorize RWF Payment",
      "data": {
        "crypto_asset": { "type": "string", "__example__": "USDC" },
        "crypto_network": { "type": "string", "__example__": "BASE" },
        "network_code": { "type": "string", "__example__": "MTN" },
        "network_name": { "type": "string", "__example__": "MTN Rwanda" },
        "phone_number": { "type": "string", "__example__": "0781234567" },
        "sell_amount": { "type": "string", "__example__": "13500" },
        "crypto_cost": { "type": "string", "__example__": "9.63" },
        "total_crypto_usd": { "type": "string", "__example__": "10.38" },
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Authorize"
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              { "type": "TextCaption", "text": "${data.error_message}" }
            ]
          },
          { "type": "TextBody", "text": "`'Network: '${data.network_name}''`" },
          { "type": "TextBody", "text": "`'Mobile Number: '${data.phone_number}''`" },
          { "type": "TextBody", "text": "`'You Receive: RWF '${data.sell_amount}''`" },
          { "type": "TextBody", "text": "`'Crypto Cost: '${data.crypto_cost}' '${data.crypto_asset}''`" },
          { "type": "TextBody", "text": "`'Fee: $0.75 USD'`" },
          { "type": "TextBody", "text": "`'Total Deducted: '${data.total_crypto_usd}' '${data.crypto_asset}''`" },
          { "type": "TextBody", "text": "Enter PIN to Confirm" },
          {
            "type": "Form",
            "name": "rwf_pin_form",
            "children": [
              {
                "type": "TextInput",
                "name": "pin",
                "label": "4 Digit PIN",
                "required": true,
                "input-type": "password",
                "min-chars": 4,
                "max-chars": 6
              },
              {
                "type": "Footer",
                "label": "Sell & Send",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "pin": "${form.pin}",
                    "crypto_asset": "${data.crypto_asset}",
                    "crypto_network": "${data.crypto_network}",
                    "network_code": "${data.network_code}",
                    "network_name": "${data.network_name}",
                    "phone_number": "${data.phone_number}",
                    "sell_amount": "${data.sell_amount}",
                    "crypto_cost": "${data.crypto_cost}",
                    "total_crypto_usd": "${data.total_crypto_usd}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
