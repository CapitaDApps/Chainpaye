{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "SELECT_COUNTRY": ["SELECT_ID_TYPE", "ID_INPUT", "VERIFICATION_COMPLETE"],
    "SELECT_ID_TYPE": ["ID_INPUT"],
    "ID_INPUT": ["VERIFICATION_COMPLETE"],
    "VERIFICATION_COMPLETE": []
  },
  "screens": [
    {
      "id": "SELECT_COUNTRY",
      "title": "KYC Verification",
      "data": {
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "country_form",
            "children": [
              { "type": "TextHeading", "text": "Verify Your Identity" },
              {
                "type": "TextBody",
                "text": "Select your country to begin identity verification and unlock all Chainpaye features."
              },
              {
                "type": "If",
                "condition": "${data.has_error}",
                "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
              },
              {
                "type": "Dropdown",
                "label": "Country",
                "name": "country",
                "required": true,
                "data-source": [
                  { "id": "NG", "title": "🇳🇬 Nigeria" },
                  { "id": "KE", "title": "🇰🇪 Kenya" },
                  { "id": "ZA", "title": "🇿🇦 South Africa" },
                  { "id": "UG", "title": "🇺🇬 Uganda" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "country": "${form.country}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SELECT_ID_TYPE",
      "title": "Select ID Type",
      "data": {
        "country": { "type": "string", "__example__": "NG" },
        "country_name": { "type": "string", "__example__": "Nigeria" },
        "id_types": {
          "type": "array",
          "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
          "__example__": [{ "id": "NIN", "title": "National ID Number (NIN)" }, { "id": "BVN", "title": "Bank Verification Number (BVN)" }]
        },
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "id_type_form",
            "children": [
              { "type": "TextHeading", "text": "`'Verify Your Identity ('${data.country_name}')'`" },
              { "type": "TextBody", "text": "Select the type of ID you want to use for verification." },
              {
                "type": "If",
                "condition": "${data.has_error}",
                "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
              },
              {
                "type": "Dropdown",
                "label": "ID Type",
                "name": "id_type",
                "required": true,
                "data-source": "${data.id_types}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "country": "${data.country}",
                    "id_type": "${form.id_type}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ID_INPUT",
      "title": "Enter Your Details",
      "data": {
        "country": { "type": "string", "__example__": "NG" },
        "id_type": { "type": "string", "__example__": "NIN" },
        "id_label": { "type": "string", "__example__": "National ID Number (NIN)" },
        "id_hint": { "type": "string", "__example__": "Enter your 11-digit NIN" },
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "id_form",
            "children": [
              { "type": "TextHeading", "text": "Identity Verification" },
              {
                "type": "TextBody",
                "text": "Enter your details exactly as they appear on your ID document."
              },
              {
                "type": "If",
                "condition": "${data.has_error}",
                "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
              },
              {
                "type": "TextInput",
                "label": "First Name",
                "name": "first_name",
                "required": true,
                "input-type": "text",
                "helper-text": "As it appears on your ID"
              },
              {
                "type": "TextInput",
                "label": "Last Name",
                "name": "last_name",
                "required": true,
                "input-type": "text",
                "helper-text": "As it appears on your ID"
              },
              {
                "type": "DatePicker",
                "label": "Date of Birth",
                "name": "dob",
                "required": true,
                "min-date": "1900-01-01",
                "max-date": "2010-01-01",
                "helper-text": "You must be 18 or older"
              },
              {
                "type": "TextInput",
                "label": "${data.id_label}",
                "name": "id_number",
                "required": true,
                "input-type": "text",
                "helper-text": "${data.id_hint}"
              },
              {
                "type": "Footer",
                "label": "Verify Identity",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "country": "${data.country}",
                    "id_type": "${data.id_type}",
                    "first_name": "${form.first_name}",
                    "last_name": "${form.last_name}",
                    "dob": "${form.dob}",
                    "id_number": "${form.id_number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "VERIFICATION_COMPLETE",
      "title": "Verification Complete",
      "terminal": true,
      "success": true,
      "data": {
        "first_name": { "type": "string", "__example__": "John" },
        "verified": { "type": "boolean", "__example__": true },
        "already_verified": { "type": "boolean", "__example__": false },
        "auto_verified": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "If",
            "condition": "${data.verified}",
            "then": [
              { "type": "TextHeading", "text": "Verification Successful! ✅" },
              { "type": "TextBody", "text": "`'Congratulations '${data.first_name}'! Your identity has been verified. You now have full access to all Chainpaye features.'`" }
            ]
          },
          {
            "type": "If",
            "condition": "${data.already_verified}",
            "then": [
              { "type": "TextHeading", "text": "Already Verified ✓" },
              { "type": "TextBody", "text": "Your account is already verified. You have full access to all features." }
            ]
          },
          {
            "type": "If",
            "condition": "${data.auto_verified}",
            "then": [
              { "type": "TextHeading", "text": "Verification Complete ✅" },
              { "type": "TextBody", "text": "`'Welcome '${data.first_name}'! KYC is not yet required for your country. Your account is now active and you have full access to all Chainpaye features.'`" }
            ]
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": { "type": "kyc-complete" }
            }
          }
        ]
      }
    }
  ]
}
